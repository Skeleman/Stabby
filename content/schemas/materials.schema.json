{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby material library",
  "type": "object",
  "required": ["schemaVersion", "offsetAmplitudeM", "offsetWavelengthM", "tiltPerKm", "surface", "strata"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "offsetAmplitudeM": { "type": "number", "minimum": 0 },
    "offsetWavelengthM": { "type": "number", "exclusiveMinimum": 0 },
    "tiltPerKm": { "type": "number", "minimum": 0 },
    "surface": {
      "type": "object",
      "required": ["strataWobbleM", "strataWobbleWavelengthM", "coatPatchAmp", "coatPatchWavelengthM", "coatGrainAmp", "coatGrainWavelengthM", "rockGrainAmp", "rockGrainWavelengthM"],
      "additionalProperties": false,
      "properties": {
        "strataWobbleM": { "type": "number", "minimum": 0, "maximum": 50 },
        "strataWobbleWavelengthM": { "type": "number", "minimum": 0.1, "maximum": 1000 },
        "coatPatchAmp": { "type": "number", "minimum": 0, "maximum": 1 },
        "coatPatchWavelengthM": { "type": "number", "minimum": 0.1, "maximum": 1000 },
        "coatGrainAmp": { "type": "number", "minimum": 0, "maximum": 1 },
        "coatGrainWavelengthM": { "type": "number", "minimum": 0.1, "maximum": 1000 },
        "rockGrainAmp": { "type": "number", "minimum": 0, "maximum": 1 },
        "rockGrainWavelengthM": { "type": "number", "minimum": 0.1, "maximum": 1000 }
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "color", "thicknessM", "hardness"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "thicknessM": { "type": "number", "minimum": 0.5, "maximum": 500 },
          "hardness": { "type": "number", "minimum": 0, "maximum": 0.99 }
        }
      }
    }
  }
}
