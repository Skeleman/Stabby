{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby material library",
  "type": "object",
  "required": ["schemaVersion", "offsetAmplitudeM", "offsetWavelengthM", "tiltPerKm", "look", "sinter", "mud", "peat", "wakes", "surface", "liquids", "strata", "kit"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "amp": { "type": "number", "minimum": 0, "maximum": 1 },
    "length": { "type": "number", "minimum": 0.01, "maximum": 1000 },
    "depth": { "type": "number", "minimum": 0, "maximum": 2 },
    "coat": {
      "type": "object",
      "required": ["biomes", "bumpAmp", "featureAmp", "featureWavelengthM", "parallax"],
      "additionalProperties": false,
      "properties": {
        "biomes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "uniqueItems": true },
        "bumpAmp": { "$ref": "#/$defs/amp" },
        "grainAmp": { "$ref": "#/$defs/amp" },
        "featureAmp": { "$ref": "#/$defs/amp" },
        "featureWavelengthM": { "$ref": "#/$defs/length" },
        "parallax": { "type": "number", "minimum": 0, "maximum": 2 },
        "albedoVar": { "$ref": "#/$defs/amp" },
        "roughness": { "$ref": "#/$defs/amp" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 6 },
    "offsetAmplitudeM": { "type": "number", "minimum": 0 },
    "offsetWavelengthM": { "type": "number", "exclusiveMinimum": 0 },
    "tiltPerKm": { "type": "number", "minimum": 0 },
    "look": {
      "type": "object",
      "required": ["noiseContrast", "albedoVar", "detailWavelengthM", "detailLacunarity", "detailOctaves", "detailGain", "saturation", "roughness", "specular"],
      "additionalProperties": false,
      "properties": {
        "noiseContrast": { "$ref": "#/$defs/amp" },
        "albedoVar": { "$ref": "#/$defs/amp" },
        "detailWavelengthM": { "$ref": "#/$defs/length" },
        "detailLacunarity": { "type": "number", "minimum": 1.5, "maximum": 4 },
        "detailOctaves": { "type": "integer", "minimum": 1, "maximum": 6 },
        "detailGain": { "$ref": "#/$defs/amp" },
        "saturation": { "$ref": "#/$defs/amp" },
        "roughness": { "$ref": "#/$defs/amp" },
        "specular": { "$ref": "#/$defs/amp" },
        "roughnessVar": { "$ref": "#/$defs/amp" }
      }
    },
    "sinter": {
      "type": "object",
      "required": ["white", "ochre", "orange", "roughness"],
      "additionalProperties": false,
      "properties": {
        "white": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ochre": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "orange": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "roughness": { "$ref": "#/$defs/amp" }
      }
    },
    "mud": {
      "type": "object",
      "required": ["surface", "clay", "grey", "roughness"],
      "additionalProperties": false,
      "properties": {
        "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "clay": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "grey": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "roughness": { "$ref": "#/$defs/amp" }
      }
    },
    "peat": {
      "type": "object",
      "required": ["wet", "dark", "fibre", "roughness"],
      "additionalProperties": false,
      "properties": {
        "wet": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "dark": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "fibre": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "roughness": { "$ref": "#/$defs/amp" }
      }
    },
    "wakes": {
      "type": "object",
      "required": ["fadePixels", "fullPixels", "ringAmplitude", "vAmplitude", "normalStrength", "refSpeedMps", "refSizeM", "speedExponent", "sizeExponent", "maxGain", "speedSmoothS"],
      "additionalProperties": false,
      "properties": {
        "fadePixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "fullPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "ringAmplitude": { "type": "number", "minimum": 0, "maximum": 4 },
        "vAmplitude": { "type": "number", "minimum": 0, "maximum": 4 },
        "normalStrength": { "type": "number", "minimum": 0, "maximum": 4 },
        "refSpeedMps": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "refSizeM": { "type": "number", "minimum": 0.1, "maximum": 50 },
        "speedExponent": { "type": "number", "minimum": 0, "maximum": 2 },
        "sizeExponent": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxGain": { "type": "number", "minimum": 1, "maximum": 10 },
        "speedSmoothS": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "liquids": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "deepColor", "shallowColor", "filmColor", "emissionColor", "clarityM", "shoreM", "foamWidthM", "waveScaleM", "waveSpeed", "waveStrength", "swellScaleM", "swellStrength", "lakeSwell", "flowSpeed", "rapidsSlope", "bedFieldM", "silt", "opacity", "viscosity", "bubbles", "film", "emission", "roughness", "fall"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "biomes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "uniqueItems": true },
          "deepColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "shallowColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "filmColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "emissionColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "clarityM": { "type": "number", "minimum": 0.1, "maximum": 100 },
          "shoreM": { "type": "number", "minimum": 0.01, "maximum": 5 },
          "opaqueDepthM": { "type": "number", "minimum": 0, "maximum": 5 },
          "foamWidthM": { "type": "number", "minimum": 0, "maximum": 50 },
          "waveScaleM": { "type": "number", "minimum": 0.01, "maximum": 1000 },
          "waveSpeed": { "type": "number", "minimum": 0, "maximum": 10 },
          "waveStrength": { "$ref": "#/$defs/amp" },
          "swellScaleM": { "type": "number", "minimum": 0.01, "maximum": 1000 },
          "swellStrength": { "$ref": "#/$defs/amp" },
          "lakeSwell": { "$ref": "#/$defs/amp" },
          "flowSpeed": { "type": "number", "minimum": 0, "maximum": 10 },
          "rapidsSlope": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "bedFieldM": { "type": "number", "minimum": 1, "maximum": 5000 },
          "silt": { "$ref": "#/$defs/amp" },
          "opacity": { "$ref": "#/$defs/amp" },
          "viscosity": { "$ref": "#/$defs/amp" },
          "groundTint": { "$ref": "#/$defs/amp" },
          "bubbles": { "$ref": "#/$defs/amp" },
          "film": { "$ref": "#/$defs/amp" },
          "emission": { "type": "number", "minimum": 0, "maximum": 8 },
          "roughness": { "$ref": "#/$defs/amp" },
          "fall": {
            "type": "object",
            "required": ["spray", "speed", "sheetOpacity", "sprayColor", "sprayAmount", "froth"],
            "additionalProperties": false,
            "properties": {
              "spray": { "enum": ["none", "mist", "dust", "shimmer"] },
              "speed": { "type": "number", "minimum": 0.05, "maximum": 4 },
              "sheetOpacity": { "$ref": "#/$defs/amp" },
              "sprayColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "sprayAmount": { "type": "number", "minimum": 0, "maximum": 2 },
              "froth": { "$ref": "#/$defs/amp" }
            }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["fadePixels", "parallaxFootprintM", "windDeg", "strataWobbleM", "strataWobbleWavelengthM", "coatPatchAmp", "coatPatchWavelengthM", "rock", "coats"],
      "additionalProperties": false,
      "properties": {
        "fadePixels": { "type": "number", "minimum": 0.5, "maximum": 16 },
        "parallaxFootprintM": { "type": "number", "minimum": 0.001, "maximum": 1 },
        "windDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "strataWobbleM": { "type": "number", "minimum": 0, "maximum": 50 },
        "strataWobbleWavelengthM": { "$ref": "#/$defs/length" },
        "coatPatchAmp": { "$ref": "#/$defs/amp" },
        "coatPatchWavelengthM": { "$ref": "#/$defs/length" },
        "rock": {
          "type": "object",
          "required": ["grainAmp", "bumpAmp", "bumpWavelengthM", "bedSpacingM", "bedDepthM", "jointSpacingM", "jointDepthM", "parallax"],
          "additionalProperties": false,
          "properties": {
            "grainAmp": { "$ref": "#/$defs/amp" },
            "bumpAmp": { "$ref": "#/$defs/amp" },
            "bumpWavelengthM": { "$ref": "#/$defs/length" },
            "bedSpacingM": { "$ref": "#/$defs/length" },
            "bedDepthM": { "$ref": "#/$defs/depth" },
            "jointSpacingM": { "$ref": "#/$defs/length" },
            "jointDepthM": { "$ref": "#/$defs/depth" },
            "parallax": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "coats": {
          "type": "object",
          "required": ["grass", "soil", "sand", "snow"],
          "additionalProperties": false,
          "properties": {
            "grass": { "$ref": "#/$defs/coat" },
            "soil": { "$ref": "#/$defs/coat" },
            "sand": { "$ref": "#/$defs/coat" },
            "snow": { "$ref": "#/$defs/coat" }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "color"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "glow": { "type": "number", "minimum": 0, "maximum": 1 },
          "translucency": { "type": "number", "minimum": 0, "maximum": 1 },
          "glowPattern": { "enum": ["facet", "cap"] },
          "keepHue": { "type": "boolean" }
        }
      }
    },
    "kit": {
      "type": "object",
      "required": ["timber", "plank", "plaster", "thatch", "iron", "cloth", "ash", "fungus", "turf", "ember", "soil"],
      "additionalProperties": false,
      "properties": {
        "timber": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 6, "maxItems": 6 },
        "plank": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1, "maxItems": 1 },
        "plaster": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 3, "maxItems": 3 },
        "thatch": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 4, "maxItems": 4 },
        "iron": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 2, "maxItems": 2 },
        "cloth": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 4, "maxItems": 4 },
        "ash": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 5, "maxItems": 5 },
        "fungus": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 10, "maxItems": 10 },
        "turf": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 2, "maxItems": 2 },
        "ember": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 2, "maxItems": 2 },
        "soil": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "color", "thicknessM", "hardness"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "thicknessM": { "type": "number", "minimum": 0.5, "maximum": 500 },
          "hardness": { "type": "number", "minimum": 0, "maximum": 0.99 }
        }
      }
    }
  }
}
