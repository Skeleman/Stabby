{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby creatures",
  "type": "object",
  "required": ["schemaVersion", "parts", "bodies"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "segments"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["leg", "neck", "head", "tail", "ear", "eye", "rigid"] },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["length", "radius"],
              "additionalProperties": false,
              "properties": {
                "length": { "type": "number", "minimum": 0, "maximum": 3 },
                "radius": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 },
                "flatten": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "tone": { "enum": ["base", "accent", "dark"] },
                "belly": { "type": "number", "minimum": 0, "maximum": 1 },
                "rump": { "type": "number", "minimum": 0, "maximum": 1 },
                "tip": { "type": "number", "minimum": 0, "maximum": 1 },
                "idle": { "$ref": "#/$defs/angles" },
                "reach": { "$ref": "#/$defs/angles" },
                "push": { "$ref": "#/$defs/angles" },
                "lift": { "$ref": "#/$defs/angles" },
                "runReach": { "$ref": "#/$defs/angles" },
                "runPush": { "$ref": "#/$defs/angles" },
                "runLift": { "$ref": "#/$defs/angles" },
                "alert": { "$ref": "#/$defs/angles" }
              }
            }
          }
        }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "biomes", "length", "radius", "materials", "size", "walkSpeed", "maxSlope", "herd", "herdChance", "detail", "wary", "slots"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "biomes": { "type": "array", "items": { "type": "string" } },
          "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
          "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
          "taper": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
          "flatten": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
          "haunch": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "waist": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "hump": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "materials": {
            "type": "object",
            "required": ["base", "accent", "dark"],
            "additionalProperties": false,
            "properties": {
              "base": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "accent": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "dark": { "type": "string", "pattern": "^[a-z][a-z-]*$" }
            }
          },
          "size": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 },
          "walkSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
          "maxSlope": { "type": "number", "minimum": 5, "maximum": 60 },
          "herd": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
          "herdChance": { "type": "number", "minimum": 0, "maximum": 1 },
          "jitter": { "type": "number", "minimum": 0, "maximum": 0.25 },
          "detail": {
            "type": "object",
            "required": ["spawnPixels", "fadePixels", "shadowPixels", "animPixels", "ikPixels", "lowPixels"],
            "additionalProperties": false,
            "properties": {
              "spawnPixels": { "type": "number", "exclusiveMinimum": 0 },
              "fadePixels": { "type": "number", "exclusiveMinimum": 0 },
              "shadowPixels": { "type": "number", "exclusiveMinimum": 0 },
              "animPixels": { "type": "number", "exclusiveMinimum": 0 },
              "ikPixels": { "type": "number", "exclusiveMinimum": 0 },
              "lowPixels": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "wary": {
            "type": "object",
            "required": ["alertPixels", "fleePixels", "calmPixels", "runSpeed", "runStride"],
            "additionalProperties": false,
            "properties": {
              "alertPixels": { "type": "number", "exclusiveMinimum": 0 },
              "fleePixels": { "type": "number", "exclusiveMinimum": 0 },
              "calmPixels": { "type": "number", "exclusiveMinimum": 0 },
              "runSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 40 },
              "runStride": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
              "dart": { "type": "number", "minimum": 0, "maximum": 60 }
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["part", "socket"],
              "additionalProperties": false,
              "properties": {
                "part": { "type": "string" },
                "parent": { "type": "string" },
                "socket": { "$ref": "#/$defs/vector" },
                "direction": { "$ref": "#/$defs/angles" },
                "mirror": { "type": "boolean" },
                "phase": { "type": "number", "minimum": 0, "maximum": 1 },
                "mirrorPhase": { "type": "number", "minimum": 0, "maximum": 1 },
                "runPhase": { "type": "number", "minimum": 0, "maximum": 1 },
                "runMirrorPhase": { "type": "number", "minimum": 0, "maximum": 1 },
                "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "angles": { "type": "array", "items": { "type": "number", "minimum": -360, "maximum": 360 }, "minItems": 3, "maxItems": 3 },
    "vector": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  }
}
