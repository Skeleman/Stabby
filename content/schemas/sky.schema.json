{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby sky and day/night cycle",
  "type": "object",
  "required": ["schemaVersion", "dayLengthS", "startHour", "sun", "moon", "moonColor", "moonIntensity", "moonSwitchHeight", "moonFadeHeight", "moonCycleDays", "moonStartPhase", "newMoonLight", "newMoonAmbient", "moonGlow", "starBrightness", "clouds", "weather", "stops"],
  "additionalProperties": false,
  "$defs": {
    "rgb": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3 },
    "orbit": {
      "type": "object",
      "required": ["noonElevationDeg", "noonAzimuthDeg", "hourOffset"],
      "additionalProperties": false,
      "properties": {
        "noonElevationDeg": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "noonAzimuthDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "hourOffset": { "type": "number", "minimum": 0, "exclusiveMaximum": 24 }
      }
    },
    "precip": {
      "type": "object",
      "required": ["count", "fallMs", "lengthM", "widthM", "swayM", "alpha", "color"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "fallMs": { "type": "number", "exclusiveMinimum": 0, "maximum": 40 },
        "lengthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
        "widthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "swayM": { "type": "number", "minimum": 0, "maximum": 4 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/rgb" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "dayLengthS": { "type": "number", "minimum": 10, "maximum": 86400 },
    "startHour": { "type": "number", "minimum": 0, "exclusiveMaximum": 24 },
    "sun": { "$ref": "#/$defs/orbit" },
    "moon": { "$ref": "#/$defs/orbit" },
    "moonColor": { "$ref": "#/$defs/rgb" },
    "moonIntensity": { "type": "number", "minimum": 0, "maximum": 2 },
    "moonSwitchHeight": { "type": "number", "minimum": -0.5, "maximum": 0 },
    "moonFadeHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "moonCycleDays": { "type": "number", "minimum": 1, "maximum": 365 },
    "moonStartPhase": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
    "newMoonLight": { "type": "number", "minimum": 0, "maximum": 1 },
    "newMoonAmbient": { "type": "number", "minimum": 0, "maximum": 1 },
    "moonGlow": { "type": "number", "minimum": 0, "maximum": 0.2 },
    "starBrightness": { "type": "number", "minimum": 0, "maximum": 0.05 },
    "clouds": {
      "type": "object",
      "required": ["coverage", "density", "heightM", "thicknessM", "scaleM", "windDirDeg", "windSpeedMs", "churn"],
      "additionalProperties": false,
      "properties": {
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "density": { "type": "number", "minimum": 0, "maximum": 8 },
        "heightM": { "type": "number", "minimum": 200, "maximum": 12000 },
        "thicknessM": { "type": "number", "minimum": 50, "maximum": 5000 },
        "scaleM": { "type": "number", "minimum": 100, "maximum": 50000 },
        "windDirDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "windSpeedMs": { "type": "number", "minimum": 0, "maximum": 60 },
        "churn": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    },
    "weather": {
      "type": "object",
      "required": ["spellS", "coverMin", "coverMax", "wetFrom", "snowBelowC", "sleetBandC", "minPx", "rain", "snow"],
      "additionalProperties": false,
      "properties": {
        "spellS": { "type": "number", "minimum": 10, "maximum": 86400 },
        "coverMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverMax": { "type": "number", "minimum": 0, "maximum": 1 },
        "wetFrom": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "snowBelowC": { "type": "number", "minimum": -30, "maximum": 10 },
        "sleetBandC": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "minPx": { "type": "number", "minimum": 0.25, "maximum": 8 },
        "rain": { "$ref": "#/$defs/precip" },
        "snow": { "$ref": "#/$defs/precip" }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["sunHeight", "sky", "zenith", "glow", "ambientSky", "ambientGround", "sun", "sunIntensity"],
        "additionalProperties": false,
        "properties": {
          "sunHeight": { "type": "number", "minimum": -1, "maximum": 1 },
          "sky": { "$ref": "#/$defs/rgb" },
          "zenith": { "$ref": "#/$defs/rgb" },
          "glow": { "$ref": "#/$defs/rgb" },
          "ambientSky": { "$ref": "#/$defs/rgb" },
          "ambientGround": { "$ref": "#/$defs/rgb" },
          "sun": { "$ref": "#/$defs/rgb" },
          "sunIntensity": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    }
  }
}
