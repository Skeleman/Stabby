{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby biomes",
  "type": "object",
  "required": ["schemaVersion", "biomes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "biomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "tempMinC", "tempMaxC", "precipMinMm", "precipMaxMm", "color"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "tempMinC": { "type": "number" },
          "tempMaxC": { "type": "number" },
          "precipMinMm": { "type": "number", "minimum": 0 },
          "precipMaxMm": { "type": "number", "minimum": 0 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "heightMinM": { "type": "number" },
          "heightMaxM": { "type": "number" },
          "waterWithinM": { "type": "number", "exclusiveMinimum": 0 },
          "waterRiseM": { "type": "number", "exclusiveMinimum": 0 },
          "coastWithinM": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
