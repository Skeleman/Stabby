{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stabby world objects",
  "type": "object",
  "required": ["schemaVersion", "lightBudget", "lights", "kinds", "objects", "terrain", "foliage"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 6 },
    "lightBudget": {
      "type": "object",
      "required": ["shadowed", "unshadowed", "glow"],
      "additionalProperties": false,
      "properties": {
        "shadowed": { "type": "integer", "minimum": 0, "maximum": 64 },
        "unshadowed": { "type": "integer", "minimum": 0, "maximum": 256 },
        "glow": { "type": "integer", "minimum": 0, "maximum": 1024 }
      }
    },
    "quality": {
      "type": "object",
      "required": ["default", "levels"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "scale"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "scale": { "type": "number", "minimum": 0.1, "maximum": 8 }
            }
          }
        }
      }
    },
    "terrain": {
      "type": "object",
      "required": ["quadPixels"],
      "additionalProperties": false,
      "properties": {
        "quadPixels": { "type": "number", "minimum": 1, "maximum": 100 },
        "contactPixels": { "type": "number", "minimum": 1, "maximum": 100 },
        "contactTexelPixels": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "mistFadePixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "mistFullPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "steamFadePixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "steamFullPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "columnFadePixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "columnFullPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "shadowTexels": { "type": "number", "minimum": 0.25, "maximum": 8 }
      }
    },
    "foliage": {
      "type": "object",
      "required": ["wind", "grass"],
      "additionalProperties": false,
      "properties": {
        "wind": {
          "type": "object",
          "required": ["directionDeg", "strength", "gustStrength", "gustScaleM", "gustSpeed", "swayHz"],
          "additionalProperties": false,
          "properties": {
            "directionDeg": { "type": "number" },
            "strength": { "type": "number", "minimum": 0, "maximum": 2 },
            "gustStrength": { "type": "number", "minimum": 0, "maximum": 2 },
            "gustScaleM": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
            "gustSpeed": { "type": "number", "minimum": 0, "maximum": 50 },
            "swayHz": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "grass": {
          "type": "object",
          "required": ["perM2", "nearPixels", "reachPixels", "thinPow", "widen", "widthMaxM", "lod1Pixels", "lod2Pixels", "heightMinM", "heightMaxM", "widthM", "bend", "tipLight", "translucency", "coatMin", "slopeMax", "maxBlades"],
          "additionalProperties": false,
          "properties": {
            "perM2": { "type": "number", "minimum": 0, "maximum": 400 },
            "nearPixels": { "type": "number", "exclusiveMinimum": 0 },
            "reachPixels": { "type": "number", "exclusiveMinimum": 0 },
            "thinPow": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "widen": { "type": "number", "minimum": 0, "maximum": 1 },
            "widthMaxM": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "lod1Pixels": { "type": "number", "exclusiveMinimum": 0 },
            "lod2Pixels": { "type": "number", "exclusiveMinimum": 0 },
            "heightMinM": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
            "heightMaxM": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
            "widthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
            "bend": { "type": "number", "minimum": 0, "maximum": 1.5 },
            "tipLight": { "type": "number", "minimum": 0, "maximum": 2 },
            "translucency": { "type": "number", "minimum": 0, "maximum": 1 },
            "coatMin": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "slopeMax": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
            "maxBlades": { "type": "integer", "minimum": 1024, "maximum": 4194304 }
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "shadowedPixels", "unshadowedPixels", "glowPixels", "importance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "shadowedPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 1080 },
          "unshadowedPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 1080 },
          "glowPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 1080 },
          "importance": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
        }
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "lods", "lodPixels", "fadePixels", "shadows", "shadowPixels", "shadowCascadePixels", "light", "wind", "animated", "solid"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["static", "interactive", "animated", "structure"] },
          "lods": { "type": "integer", "minimum": 1, "maximum": 4 },
          "lodPixels": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1080 }, "maxItems": 3 },
          "fadePixels": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1080 },
          "shadows": { "type": "boolean" },
          "shadowPixels": { "type": "number", "minimum": 0 },
          "shadowCascadePixels": { "type": "number", "minimum": 0 },
          "light": { "type": "string", "minLength": 1 },
          "wind": { "type": "boolean" },
          "swayPixels": { "type": "number", "minimum": 0, "maximum": 1080 },
          "impostorPixels": { "type": "number", "minimum": 0, "maximum": 1080 },
          "flutterPixels": { "type": "number", "minimum": 0, "maximum": 1080 },
          "animated": { "type": "boolean" },
          "solid": { "type": "boolean" }
        }
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "stone", "trim"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "stone": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "trim": { "enum": ["timber", "plank", "plaster", "thatch", "iron", "cloth", "ash", "fungus", "turf", "ember"] }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "parts", "placement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["static", "interactive", "animated", "structure"] },
          "material": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "style": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "variants": { "type": "integer", "minimum": 1, "maximum": 16 },
          "interact": {
            "type": "object",
            "required": ["verb", "reachM"],
            "additionalProperties": false,
            "properties": {
              "verb": { "enum": ["take", "cut"] },
              "reachM": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
            }
          },
          "light": {
            "type": "object",
            "required": ["category", "material", "intensity", "radiusM"],
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "material": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "intensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "radiusM": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
              "importance": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
              "flicker": { "type": "number", "minimum": 0, "maximum": 1 },
              "flickerHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
              "liftM": { "type": "number", "minimum": 0, "maximum": 20 },
              "coneDeg": { "type": "number", "minimum": 0, "maximum": 150 },
              "daylight": { "type": "boolean" },
              "core": { "type": "boolean" }
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "shape"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "shape": { "enum": ["rock", "log", "stump", "shrub", "broadleaf", "conifer", "dry-stone-wall", "cairn", "reed", "inn", "inn-yard", "table", "bench", "barrel", "crate", "market-stall", "well", "stone-ring", "tent", "fire-pit", "log-seat", "campsite", "hermit-hut", "hermitage", "road-shrine", "wayside", "ruin", "hot-spring", "mushroom", "fairy-ring", "geyser", "mud-pot", "basalt-columns", "crystal-cluster", "wolf-den", "dripstone", "dripstone-column", "dungeon-corridor", "dungeon-room", "dungeon-stairs", "dungeon-door", "dungeon-pillar", "dungeon-collapse", "dungeon"] },
                "offset": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                "scale": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 },
                "solid": { "enum": ["", "on", "off"] },
                "shadows": { "enum": ["", "on", "off"] },
                "material": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
                "leafMaterial": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
                "ends": { "enum": ["auto", "torn", "sawn", "rooted", "snapped", "worn"] }
              }
            }
          },
          "placement": {
            "type": "object",
            "required": ["perHectare"],
            "additionalProperties": false,
            "properties": {
              "biomes": { "type": "array", "items": { "type": "string" } },
              "perHectare": { "type": "number", "minimum": 0, "maximum": 400 },
              "slopeMin": { "type": "number", "minimum": 0 },
              "slopeMax": { "type": "number", "exclusiveMinimum": 0 },
              "hardnessMin": { "type": "number", "minimum": 0, "maximum": 1 },
              "hardnessMax": { "type": "number", "minimum": 0, "maximum": 1 },
              "sizeMinM": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
              "sizeMaxM": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
              "clusterCount": { "type": "integer", "minimum": 1, "maximum": 32 },
              "clusterRadiusM": { "type": "number", "minimum": 0, "maximum": 30 },
              "sink": { "type": "number", "minimum": 0, "maximum": 0.9 },
              "alignToSlope": { "type": "number", "minimum": 0, "maximum": 1 },
              "footRiseM": { "type": "number", "minimum": 0, "maximum": 100 },
              "footReachM": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
              "fanM": { "type": "number", "minimum": 0, "maximum": 30 },
              "editMinSizeM": { "type": "number", "minimum": 0, "maximum": 20 },
              "chainMin": { "type": "integer", "minimum": 1, "maximum": 24 },
              "chainMax": { "type": "integer", "minimum": 1, "maximum": 24 },
              "chainCorner": { "type": "number", "minimum": 0, "maximum": 1 },
              "chainGate": { "type": "number", "minimum": 0, "maximum": 1 },
              "bank": { "enum": ["reed", "bar", "drift", "rapid"] },
              "perHundredM": { "type": "number", "minimum": 0, "maximum": 800 },
              "discovery": { "enum": ["hilltop", "clearing", "camp", "hermit", "shrine", "ruin", "spring", "fairy-ring", "geyser", "mud-pot", "wolf-den", "dungeon"] },
              "cave": { "enum": ["stalactite", "stalagmite", "rubble", "column", "crystal", "fungus", "crystal-light", "skylight"] },
              "caveIce": { "type": "boolean" },
              "liquid": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
              "spacingM": { "type": "number", "minimum": 200, "maximum": 5000 },
              "chance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "biomeDensity": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["biome", "scale"],
                  "additionalProperties": false,
                  "properties": {
                    "biome": { "type": "string" },
                    "scale": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
