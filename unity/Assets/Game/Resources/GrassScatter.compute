#pragma kernel Scatter

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

float4 _StabbySand, _StabbyFieldUV;
float _StabbyStrataPeriod;
float3 _WorldSpaceCameraPos;
TEXTURE2D(_StabbyStrata);
SAMPLER(sampler_StabbyStrata);
TEXTURE2D(_StabbySlope);
SAMPLER(sampler_StabbySlope);
TEXTURE2D(_StabbyBiome);
SAMPLER(sampler_StabbyBiome);

float3 ToLinear(float3 c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }

#define ddx(x) ((x) * 0)
#define ddy(x) ((x) * 0)
#include "Assets/Viewer/Shaders/TerrainMaterials.hlsl"

struct Blade { float4 p0; uint4 q; };

ByteAddressBuffer _Verts;
ByteAddressBuffer _Indices;
RWByteAddressBuffer _Args;
RWStructuredBuffer<Blade> _Blades;
float4 _Planes[6];
float4 _Eye;
float4 _GrassA;
float4 _GrassB;
float4 _GrassC;
float4 _GrassD;
uint4 _Layout;

float Rand(int3 cell, uint salt) { return TmHashU(uint3(cell.x, cell.y, cell.z * 16 + salt)) * (1.0 / 4294967296.0); }

bool Outside(float3 p, float r)
{
    [unroll] for (int k = 0; k < 6; k++)
        if (dot(_Planes[k].xyz, p) + _Planes[k].w < -r) return true;
    return false;
}

float3 Pos(uint i) { return asfloat(_Verts.Load3(i * _Layout.x)); }
float4 Attr(uint i, uint off) { return asfloat(_Verts.Load4(i * _Layout.x + off)); }

[numthreads(64, 1, 1)]
void Scatter(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Layout.w) return;
    uint3 ix = _Indices.Load3(id.x * 12);
    float3 a = Pos(ix.x), b = Pos(ix.y), c = Pos(ix.z);
    float3 ctr = (a + b + c) / 3;
    float rad = sqrt(max(max(dot(a - ctr, a - ctr), dot(b - ctr, b - ctr)), dot(c - ctr, c - ctr)));
    float reach = _GrassA.z, near = _GrassA.y, hMax = _GrassB.y * 1.8;
    float dc = distance(ctr, _Eye.xyz);
    if (dc - rad > reach || Outside(ctr, rad + hMax)) return;
    float3 cr = cross(b - a, c - a);
    float area2 = length(cr);
    if (area2 < 1e-6) return;
    float3 fn = cr / area2;
    fn *= fn.y < 0 ? -1 : 1;
    if (fn.y < 0.05 || sqrt(max(0, 1 - fn.y * fn.y)) / fn.y > _GrassA.w) return;
    float thin = _GrassD.x;
    float keepTri = min(1, pow(near / max(dc - rad, 1e-3), thin));
    float cand = 0.5 * area2 * _GrassA.x;
    uint count = (uint)cand + (Rand(int3(round(ctr.xz * 16), 0), 15) < frac(cand) ? 1u : 0u);
    uint tries = min(count, (uint)ceil(keepTri * count) + 1);
    float4 ca = Attr(ix.x, _Layout.y), cb = Attr(ix.y, _Layout.y), cc = Attr(ix.z, _Layout.y);
    float4 sa = Attr(ix.x, _Layout.z), sb = Attr(ix.y, _Layout.z), sc = Attr(ix.z, _Layout.z);
    float2 o2 = TmOrigin(_Eye.xyz);
    tmO = float3(o2.x, 0, o2.y);
    int2 key = int2(round(ctr.xz * 16));
    float invCount = 1.0 / max(count, 1u);
    for (uint k = 0; k < tries; k++)
    {
        int3 cell = int3(key, k);
        float rank = (k + Rand(cell, 0)) * invCount;
        if (rank >= keepTri) continue;
        float u = Rand(cell, 1), v = Rand(cell, 2);
        if (u + v > 1) { u = 1 - u; v = 1 - v; }
        float w = 1 - u - v;
        float3 p = a * w + b * u + c * v;
        if (sa.w * w + sb.w * u + sc.w * v > -0.3) continue;
        float d = distance(p, _Eye.xyz);
        float keep = min(1, pow(near / max(d, 1e-3), thin));
        if (d > reach || rank >= keep || Outside(p, hMax)) continue;
        float2 xa = p.xz;
        float4 col = ca * w + cb * u + cc * v;
        float4 st = sa * w + sb * u + sc * v;
        float3 color = col.rgb, n = fn;
        float mix = st.y, f = saturate(st.z);
        if (f > 0)
        {
            float2 sl = SAMPLE_TEXTURE2D_LOD(_StabbySlope, sampler_StabbySlope, xa * _StabbyFieldUV.x + _StabbyFieldUV.y, 0).rg;
            float4 bo = SAMPLE_TEXTURE2D_LOD(_StabbyBiome, sampler_StabbyBiome, xa * _StabbyFieldUV.z + _StabbyFieldUV.w, 0);
            float3 gn = normalize(float3(-sl.x, 1, -sl.y));
            float slope = sqrt(max(0, 1 - gn.y * gn.y)) / max(gn.y, 0.05), shoreF = saturate(1 - p.y / 6);
            color = lerp(color, ToLinear(bo.rgb), f);
            mix = lerp(mix, saturate((slope - 0.25) / 0.35) * (1 - shoreF), f);
            n = normalize(lerp(n, gn, f));
        }
        float jn = TmNoise2(xa * 0.27 + 41.7).x;
        float4 cw = SAMPLE_TEXTURE2D_LOD(_StabbyCoat, sampler_StabbyCoat, xa * _StabbyCoatUV.x + _StabbyCoatUV.y, 0);
        float shore = smoothstep(5.5, 2.5, p.y);
        cw = lerp(cw, float4(0, 0, 1, 0), shore);
        cw = saturate(cw * (1 + 0.8 * (1 - shore) * float4(jn, -jn, jn * 0.3, -jn)));
        cw /= max(dot(cw, 1), 1e-3);
        float m = saturate((mix - 0.5) * 1.6 + 0.5 + 0.3 * jn);
        float up = saturate((min(n.y, fn.y) - 0.35) / 0.35);
        float4 fo = SAMPLE_TEXTURE2D_LOD(_StabbyForest, sampler_StabbyForest, xa * _StabbyCoatUV.x + _StabbyCoatUV.y, 0);
        float3 lp = float3(p.x - tmO.x, p.y, p.z - tmO.z);
        float hw = p.y - SAMPLE_TEXTURE2D_LOD(_StabbyWaterLevel, sampler_StabbyWaterLevel, xa * _StabbyCoatUV.x + _StabbyCoatUV.y, 0).r;
        float2 wd = hw < 4.8 ? TmWet(lp, hw, max(d * _Eye.w, 1e-4)) : 0;
        float gw = cw.x * (1 - m) * up * (1 - TmFloorCover(xa - tmO.xz, fo, max(d * _Eye.w, 1e-4)).y) * (1 - 0.85 * smoothstep(0.45, 1, wd.x));
        float cmin = _GrassB.w, gate = cmin + (1 - cmin) * Rand(cell, 3);
        if (gw * 1.2 <= gate) continue;
        float sw = _StabbyStrataWobble.w;
        float hn = 0.65 * TmNoise2(xa * sw * 2.7 + 5.3).x + 0.35 * TmNoise2(xa * sw * 0.6 + 1.9).x;
        float2 dw = mul(float2x2(0.8, -0.6, 0.6, 0.8), xa);
        float dirt = smoothstep(0.35, 1.0, TmNoise2(dw * 0.035 + 31.3).x + 0.5 * TmNoise2(dw * 0.09 + 7.1).x);
        float cl = TmL2(xa - tmO.xz, _StabbyCoatB[0].y, 3.7).x;
        gw *= saturate(0.85 + 0.45 * cl + 0.55 * hn) * (1 - 0.9 * dirt) * 1.2;
        if (gw <= gate) continue;
        float2 cg = xa * (1.0 / 0.55), cf = frac(cg), bo = 0;
        int2 ci = (int2)floor(cg), bc = ci;
        float best = 9;
        [unroll] for (int j = 0; j < 9; j++)
        {
            int2 o = int2(j % 3 - 1, j / 3 - 1);
            uint h = TmHashU(uint3((uint)(ci.x + o.x), (uint)(ci.y + o.y), 0x6c1du));
            float2 dv = o + float2(h & 0xffff, h >> 16) * (1.0 / 65535) - cf;
            float dd = dot(dv, dv);
            if (dd < best) { best = dd; bo = dv; bc = ci + o; }
        }
        uint ch = TmHashU(uint3((uint)bc.x, (uint)bc.y, 0x9e37u));
        float4 cr4 = float4(ch & 255, (ch >> 8) & 255, (ch >> 16) & 255, ch >> 24) * (1.0 / 255);
        float dr = saturate(sqrt(best) * 1.5);
        float faceA = atan2(-bo.y, -bo.x) * (1.0 / 6.2831853) + (Rand(cell, 5) - 0.5) * 0.3;
        float leanAmt = saturate((0.2 + 0.8 * dr) * (0.55 + 0.9 * cr4.z));
        float dry = Rand(cell, 9) < saturate(0.06 + 0.3 * saturate(-1.5 * hn) + 0.3 * dirt + 0.08 * (cr4.y - 0.5)) * smoothstep(0.35, 0.85, col.a) ? 0.45 + 0.55 * Rand(cell, 10) : 0;
        bool seedHead = Rand(cell, 11) < 0.035 * (0.4 + 1.2 * cr4.z);
        float fp = max(d * _Eye.w, 1e-4);
        float3 root = color;
        [branch] if (_StabbyDetailOff <= 0)
        {
            TmOut g = TmGrass(lp, color, fp, _StabbyCoatA[0], _StabbyCoatB[0]);
            root = lerp(TmGrassGreen(color), g.albedo, 0.45 * up);
        }
        root = lerp(root, root * root * 2.2, 0.5 * wd.y) * (1 - 0.3 * wd.y);
        float lum = dot(root, float3(0.2126, 0.7152, 0.0722));
        float hv = cr4.w - 0.5 + 0.3 * (Rand(cell, 12) - 0.5);
        root = lerp(lum.xxx, root, 0.58 + 0.12 * cr4.x) * float3(1.04 + 0.08 * hv, 1, 0.88 - 0.08 * hv) * (0.86 + 0.16 * cr4.y) * (0.93 + 0.12 * Rand(cell, 8));
        float yel = Rand(cell, 13) < 0.03 + 0.1 * dirt + 0.06 * saturate(-1.5 * hn) ? 0.35 + 0.4 * Rand(cell, 14) : 0;
        root = lerp(root, dot(root, float3(0.2126, 0.7152, 0.0722)) * float3(1.32, 1.17, 0.76), yel);
        float fadeOut = smoothstep(reach, 0.7 * reach, d);
        float grow = saturate((keep - rank) / (0.3 * keep));
        float hgt = lerp(_GrassB.x, _GrassB.y, Rand(cell, 4)) * saturate(0.4 + gw) * fadeOut * grow * (0.65 + 0.7 * cr4.x) * (1 - 0.3 * dr * dr) * (seedHead ? 1.3 : 1);
        if (hgt < 0.01) continue;
        float wid = min(_GrassB.z * pow(abs(keep), -_GrassD.y), _GrassD.z) * (0.75 + 0.55 * cr4.y) * (0.85 + 0.3 * Rand(cell, 7));
        uint lod = d < _GrassD.w ? 0 : d < _GrassC.w ? 1 : 2;
        uint slot;
        _Args.InterlockedAdd(lod * 16 + 4, 1, slot);
        uint cap = (uint)_GrassC.y;
        if (slot >= cap) { _Args.InterlockedAdd(lod * 16 + 4, 0xffffffffu); continue; }
        Blade bl;
        bl.p0 = float4(p, hgt);
        uint3 re = (uint3)(sqrt(saturate(root)) * 1023 + 0.5);
        bl.q.x = (uint)(frac(faceA) * 65535) | ((uint)(Rand(cell, 6) * 65535) << 16);
        bl.q.y = f32tof16(wid) | ((uint)(saturate(col.a) * 255 + 0.5) << 16) | ((uint)(fadeOut * 255 + 0.5) << 24);
        bl.q.z = re.x | (re.y << 10) | (re.z << 20) | (seedHead ? 1u << 30 : 0u);
        bl.q.w = (uint)(leanAmt * 255 + 0.5) | ((uint)(dry * 255 + 0.5) << 8) | ((uint)(n.x * 127.5 + 127.5) << 16) | ((uint)(n.z * 127.5 + 127.5) << 24);
        _Blades[lod * cap + slot] = bl;
    }
}
